# App
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=epermit

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# File storage root (signatures, permit evidence). Must be OUTSIDE src/ —
# never served statically. Default: `storage` (relative to cwd). On a VPS,
# use an absolute path owned by the Node process user, e.g.
#   STORAGE_PATH=/var/www/epermit/storage
STORAGE_PATH=storage

# Migrations: run pending src/database/migrations/*.sql automatically on
# app boot. Set to "false" in multi-instance production deployments and
# run `npm run migrate` as a separate deploy step instead.
AUTO_MIGRATE_ON_BOOT=true
